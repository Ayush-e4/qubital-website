# PostHog analytics — optional.
# When NEXT_PUBLIC_POSTHOG_KEY is unset, src/components/PostHogProvider.tsx
# disables analytics silently, so the app runs fine without these.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the bundle at BUILD time, not read
# at runtime. One build cannot serve two environments — build per environment,
# or supply these during `next build` in the pipeline.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Contact form email (src/app/api/contact/route.ts) — optional.
#
# Server-only: these have no NEXT_PUBLIC_ prefix on purpose, so they are read at
# REQUEST time and never reach the browser bundle. Unlike the PostHog pair above
# they do not need to be present during `next build` — but the process must be
# restarted for a change to take effect (a redeploy, or restarting the container).
#
# Without the three GRAPH_* values the endpoint returns 500 and the form shows
# its error state — deliberately not a success message, so a lead is never
# silently lost.
#
# Mail is sent through Microsoft Graph from a Microsoft 365 mailbox. The Entra
# app needs the application permission Mail.Send, scoped to that one mailbox —
# see "Sending through Microsoft 365" in the README for the setup.
#
# GRAPH_TENANT_ID     Entra tenant (directory) ID.
# GRAPH_CLIENT_ID     Entra app (client) ID.
# GRAPH_CLIENT_SECRET Entra app client secret. Note when it expires.
# CONTACT_TO_EMAIL    Where inquiries are delivered.
# CONTACT_CC_EMAIL    Copied on every inquiry.
# CONTACT_FROM_EMAIL  The mailbox Graph sends as (default hello@qubital.eu).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
CONTACT_TO_EMAIL=hello@qubital.eu
CONTACT_CC_EMAIL=arun1812@gmail.com
CONTACT_FROM_EMAIL=hello@qubital.eu

# Contact form rate limiting — optional, defaults shown. Per instance, so these
# bound accidental double-submits and casual abuse, not a distributed attacker;
# see the comment at the top of src/lib/contact/rate-limit.ts.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
